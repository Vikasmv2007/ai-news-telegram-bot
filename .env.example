# =====================================================================
#  AI News Intelligence Bot - configuration
#  Copy this file to ".env" and fill in your values. NEVER commit .env.
# =====================================================================

# ---------- Telegram (REQUIRED, free) ----------
# 1. In Telegram, open @BotFather -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# 2. Start the bot, send it /start: it replies with your chat ID. Put it here.
#    Several IDs: comma-separated. Only these chats can use the bot.
ALLOWED_CHAT_IDS=
# Who may use /status and /preview (defaults to ALLOWED_CHAT_IDS)
ADMIN_CHAT_IDS=

# ---------- AI provider ----------
# auto = try gemini -> groq -> anthropic (whichever has a key), then fall back
#        to feed text if none work.  Options: auto | gemini | groq | anthropic | none
LLM_PROVIDER=auto

# Google Gemini - FREE tier. Key: https://aistudio.google.com/apikey
# (Free-tier prompts may be used by Google to improve products; only public
#  news headlines are sent.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq - FREE tier (good backup). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude - PAID (needs prepaid credits). Leave empty to stay free.
# claude-haiku-5-5 is the cheapest Claude model if you want to save money.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Articles per AI request / max articles analysed per refresh (free-tier friendly:
# 24 articles / 8 per request = 3 requests per refresh, ~150 requests per day)
AI_BATCH_SIZE=8
AI_MAX_ARTICLES_PER_RUN=24
AI_TIMEOUT_SECONDS=60

# ---------- Schedule (24-hour HH:MM, in TIMEZONE) ----------
TIMEZONE=Asia/Kolkata
SCHEDULE_MORNING=07:00
SCHEDULE_PREMARKET=09:00
SCHEDULE_MIDDAY=13:00
SCHEDULE_CLOSING=16:00
SCHEDULE_EVENING=20:00
# Turn a whole schedule off for everyone (users can also toggle in /settings)
SCHEDULE_MORNING_ENABLED=true
SCHEDULE_PREMARKET_ENABLED=true
SCHEDULE_MIDDAY_ENABLED=true
SCHEDULE_CLOSING_ENABLED=true
SCHEDULE_EVENING_ENABLED=true
# If the bot was off at a briefing time, send it on start-up if no later than this
CATCH_UP_MINUTES=45

# ---------- News pipeline ----------
COLLECT_INTERVAL_MINUTES=30
ARTICLE_MAX_AGE_HOURS=36
ITEMS_PER_CATEGORY=4

# Breaking alerts: only importance >= this, at most N per day, never in quiet hours
BREAKING_ALERTS_ENABLED=true
BREAKING_MIN_IMPORTANCE=9
BREAKING_MAX_PER_DAY=4
QUIET_HOURS=23:00-06:30

# ---------- Market data (free, Yahoo Finance, delayed/unofficial) ----------
MARKET_DATA_ENABLED=true
DEFAULT_WATCHLIST=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS

# ---------- Storage ----------
# Empty = SQLite file at data/news.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/newsbot
DATABASE_URL=

# ---------- Operations ----------
TEST_MODE=false
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
# Health endpoint port (0 = off). Docker image sets 8080.
HEALTH_PORT=0
